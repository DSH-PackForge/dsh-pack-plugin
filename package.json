{
  "name": "@dsh-packforge/dsh-pack-plugin",
  "version": "0.2.0",
  "type": "module",
  "description": "DSH 纯方案 B 插件 bundle：.dspack 导出/导入/多 profile，零官方源码改动、零第三方插件",
  "license": "MIT",
  "author": {
    "name": "hxh230802",
    "url": "https://github.com/hxh230802"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DSH-PackForge/dsh-pack-plugin.git"
  },
  "homepage": "https://github.com/DSH-PackForge/dsh-pack-plugin#readme",
  "bugs": {
    "url": "https://github.com/DSH-PackForge/dsh-pack-plugin/issues"
  },
  "icon": "icons/folder-zip-line.svg",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src",
    "lib",
    "icons",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "dspack",
    "整合包",
    "cordis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --experimental-test-isolation=none \"test/*.test.js\"",
    "bundle": "node scripts/bundle-client.mjs",
    "prepack": "npm run bundle && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "proxy-agent": "^8.0.2",
    "proxy-from-env": "^2.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
